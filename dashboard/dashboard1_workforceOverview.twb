      <aliases enabled='yes' />
      <column caption='Employment Trend' datatype='string' name='[Calculation_0232459890446338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([employment_change_pct]) THEN &quot;Unavailable&quot;&#10;ELSEIF [employment_change_pct] &gt; 0 THEN &quot;Increased&quot;&#10;ELSEIF [employment_change_pct] &lt; 0 THEN &quot;Decreased&quot;&#10;ELSE &quot;No change&quot;&#10;END' />
      </column>
      <column caption='Growing Occupations' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0232460037451782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [employment_change] &gt; 0&#10;    THEN [occupation_code]&#10;    END&#10;)' />
      </column>
      <column caption='Selected Rank Metric' datatype='real' name='[Calculation_0232460048371720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0232460048003079]&#10;WHEN &quot;Fastest Growth&quot; THEN [employment_change_pct]&#10;WHEN &quot;Largest Employment Gains&quot; THEN [employment_change]&#10;WHEN &quot;Highest Paying&quot; THEN [median_wage_2025]&#10;END' />
      </column>
      <column caption='Rank Label' datatype='string' name='[Calculation_0232460057337868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0232460048003079]&#10;&#10;WHEN &quot;Fastest Growth&quot; THEN&#10;    STR(ROUND([employment_change_pct] * 100, 1)) + &quot;%&quot;&#10;&#10;WHEN &quot;Largest Employment Gains&quot; THEN&#10;    STR(INT(ROUND([employment_change] / 1000, 0))) + &quot;K&quot;&#10;&#10;WHEN &quot;Highest Paying&quot; THEN&#10;    &quot;$&quot; + STR(INT(ROUND([median_wage_2025] / 1000, 0))) + &quot;K&quot;&#10;&#10;END' />
      </column>
      <column caption='Group Employment Change %' datatype='real' default-format='p0.0%' name='[Calculation_0232460083511309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM([employment_2025]) -&#10;    SUM([employment_2024])&#10;)&#10;/&#10;SUM([employment_2024])' />
      </column>
      <column caption='Group Employment Trend' datatype='string' name='[Calculation_0232460085653520]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([employment_2025]) &gt;= SUM([employment_2024])&#10;THEN &quot;Increased&quot;&#10;ELSE &quot;Decreased&quot;&#10;END' />
      </column>
      <column caption='Net Employment Change %' datatype='real' name='[Calculation_0232460095750162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([employment_2025]) / SUM([employment_2024]) - 1' />
      </column>
      <column caption='Share of Occupations Growing' datatype='real' default-format='p0.0%' name='[Calculation_0232460098420758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [employment_change] &gt; 0&#10;    THEN [occupation_code]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF NOT ISNULL([employment_change])&#10;    THEN [occupation_code]&#10;    END&#10;)' />
      </column>
      <column caption='Median Occupation Change' datatype='real' default-format='p0.0%' name='[Calculation_0232460099174423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([employment_change_pct])' />
      </column>
