      <table>
        <view>
          <datasources>
            <datasource caption='Workforce Data' name='federated.06ssybx0nh5feq17mjc4m021bnf5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='contant=0' datatype='real' name='[Parameter 0232459892453379]' param-domain-type='any' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06ssybx0nh5feq17mjc4m021bnf5'>
            <column caption='Employment Trend' datatype='string' name='[Calculation_0232459890446338]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([employment_change_pct]) THEN &quot;Unavailable&quot;&#10;ELSEIF [employment_change_pct] &gt; 0 THEN &quot;Increased&quot;&#10;ELSEIF [employment_change_pct] &lt; 0 THEN &quot;Decreased&quot;&#10;ELSE &quot;No change&quot;&#10;END' />
            </column>
            <column caption='Employment 2025' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[employment_2025]' role='measure' type='quantitative' />
            <column caption='Employment Change' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[employment_change]' role='measure' type='quantitative' />
            <column caption='Employment Change Pct' datatype='real' default-format='p0.00%' name='[employment_change_pct]' role='measure' type='quantitative' />
            <column caption='Major Group Title' datatype='string' name='[major_group_title]' role='dimension' type='nominal' />
