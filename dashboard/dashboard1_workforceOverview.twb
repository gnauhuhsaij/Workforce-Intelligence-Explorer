            <column-instance column='[Calculation_0232459890446338]' derivation='None' name='[none:Calculation_0232459890446338:nk]' pivot='key' type='nominal' />
            <column-instance column='[major_group_title]' derivation='None' name='[none:major_group_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[occupation_title]' derivation='None' name='[none:occupation_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[typical_education]' derivation='None' name='[none:typical_education:nk]' pivot='key' type='nominal' />
