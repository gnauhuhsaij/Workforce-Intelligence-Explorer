            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Workforce Data' name='federated.06ssybx0nh5feq17mjc4m021bnf5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rank Metric' datatype='string' name='[Parameter 0232460048003079]' param-domain-type='list' role='measure' type='nominal' value='&quot;Largest Employment Gains&quot;'>
              <calculation class='tableau' formula='&quot;Largest Employment Gains&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06ssybx0nh5feq17mjc4m021bnf5'>
            <column caption='Selected Rank Metric' datatype='real' name='[Calculation_0232460048371720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0232460048003079]&#10;WHEN &quot;Fastest Growth&quot; THEN [employment_change_pct]&#10;WHEN &quot;Largest Employment Gains&quot; THEN [employment_change]&#10;WHEN &quot;Highest Paying&quot; THEN [median_wage_2025]&#10;END' />
            </column>
            <column caption='Rank Label' datatype='string' name='[Calculation_0232460057337868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0232460048003079]&#10;&#10;WHEN &quot;Fastest Growth&quot; THEN&#10;    STR(ROUND([employment_change_pct] * 100, 1)) + &quot;%&quot;&#10;&#10;WHEN &quot;Largest Employment Gains&quot; THEN&#10;    STR(INT(ROUND([employment_change] / 1000, 0))) + &quot;K&quot;&#10;&#10;WHEN &quot;Highest Paying&quot; THEN&#10;    &quot;$&quot; + STR(INT(ROUND([median_wage_2025] / 1000, 0))) + &quot;K&quot;&#10;&#10;END' />
            </column>
            <column caption='Employment Change' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[employment_change]' role='measure' type='quantitative' />
            <column caption='Employment Change Pct' datatype='real' default-format='p0.00%' name='[employment_change_pct]' role='measure' type='quantitative' />
            <column caption='Major Group Title' datatype='string' name='[major_group_title]' role='dimension' type='nominal' />
            <column caption='Median Wage 2025' datatype='integer' name='[median_wage_2025]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0232460057337868]' derivation='None' name='[none:Calculation_0232460057337868:nk]' pivot='key' type='nominal' />
            <column-instance column='[major_group_title]' derivation='None' name='[none:major_group_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[occupation_title]' derivation='None' name='[none:occupation_title:nk]' pivot='key' type='nominal' />
            <column caption='Occupation Title' datatype='string' name='[occupation_title]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0232460048371720]' derivation='Sum' name='[sum:Calculation_0232460048371720:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.06ssybx0nh5feq17mjc4m021bnf5].[none:major_group_title:nk]' context='true' filter-group='3'>
            <groupfilter function='level-members' level='[none:major_group_title:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.06ssybx0nh5feq17mjc4m021bnf5].[none:occupation_title:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Calculation_0232460048371720])' function='order' user:ui-marker='order'>
