      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Medium'>Employment Change</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium'>2024–2025</run>
