      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Workforce Data' name='federated.06ssybx0nh5feq17mjc4m021bnf5' />
          </datasources>
          <datasource-dependencies datasource='federated.06ssybx0nh5feq17mjc4m021bnf5'>
            <column caption='Net Employment Change %' datatype='real' name='[Calculation_0232460095750162]' role='measure' type='quantitative'>
