  <worksheets>
    <worksheet name='Employment by Occupation Group'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Medium'>Employment Change by Major Occupational Group</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium'>May 2024–May 2025 estimates</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Workforce Data' name='federated.06ssybx0nh5feq17mjc4m021bnf5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='contant=0' datatype='real' name='[Parameter 0232459892453379]' param-domain-type='any' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06ssybx0nh5feq17mjc4m021bnf5'>
            <column caption='Group Employment Change %' datatype='real' default-format='p0.0%' name='[Calculation_0232460083511309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM([employment_2025]) -&#10;    SUM([employment_2024])&#10;)&#10;/&#10;SUM([employment_2024])' />
            </column>
            <column caption='Group Employment Trend' datatype='string' name='[Calculation_0232460085653520]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([employment_2025]) &gt;= SUM([employment_2024])&#10;THEN &quot;Increased&quot;&#10;ELSE &quot;Decreased&quot;&#10;END' />
