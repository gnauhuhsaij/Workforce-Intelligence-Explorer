    <worksheet name='Workforce Specialization'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Medium'><![CDATA[How <[federated.06ssybx0nh5feq17mjc4m021bnf5].[none:industry_title:nk]> Differs from the U.S. Workforce]]></run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Workforce Data' name='federated.06ssybx0nh5feq17mjc4m021bnf5' />
          </datasources>
          <datasource-dependencies datasource='federated.06ssybx0nh5feq17mjc4m021bnf5'>
            <column caption='National Group Share' datatype='real' default-format='p0.0%' name='[Calculation_0232460456509464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [major_group_title] : SUM([employment_2025]) }&#10;/&#10;{ FIXED : SUM([employment_2025]) }' />
            </column>
            <column caption='Industry Group Share' datatype='real' default-format='p0.0%' name='[Calculation_0232460456775705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([industry_share_2025])' />
            </column>
